          "name": "market",
          "writable": true
        },
        {
          "name": "stock_mint",
          "writable": true,
          "relations": [
            "market"
          ]
        },
        {
          "name": "treasury",
          "writable": true,
          "relations": [
            "market"
          ]
        },
        {
          "name": "reference",
          "relations": [
            "market"
          ]
        },
        {
          "name": "payer_usdc",
          "docs": [
            "USDC leaves here. Its authority signs (a user, or the plan PDA via CPI)."
          ],
          "writable": true
        },
        {
          "name": "payer_authority",
          "signer": true
        },
        {
          "name": "recipient",
          "docs": [
