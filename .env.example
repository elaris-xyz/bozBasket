DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
KEEPER_PUBKEY=
# Pyth Hermes needs a key since 2026-08-26. Free trial at https://terminal.pyth.network
PYTH_API_KEY=
PYTH_HERMES_URL=https://hermes.pyth.network
# Keeper
KEEPER_KEYPAIR=~/.config/solana/id.json
OFF_HOURS_POLICY=strict
KEEPER_POLL_SECONDS=60
CU_PRICE_MICROLAMPORTS=50000
# pyth (default, real receiver) or mock (devnet demo mode; run scripts/set-reference.ts mock first)
REFERENCE_SOURCE=pyth
SKIP_STALE_OLDER_THAN_SECS=604800
# Web app (server routes): keeper secret key as a JSON byte array, and the public RPC for the browser
KEEPER_SECRET_KEY=
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
DEMO_CONTROLS=1
